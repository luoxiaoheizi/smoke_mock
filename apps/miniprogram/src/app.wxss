page { background:#f3f2eb;color:#253a33;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;font-size:28rpx; }
view,button { box-sizing:border-box; } button { border-radius:14rpx;font-size:27rpx;font-weight:500;line-height:1.45;padding:23rpx 28rpx;background:#e5e8dc;color:#354a3e;margin:0; }button::after{border:none}button[disabled]{background:#e0e1d8;color:#9ca599}
button.primary { background:#344f41;color:#f4efd9; }button.secondary { background:transparent;border:1rpx solid #b7c0ae; }button.small { font-size:23rpx;padding:15rpx 22rpx; }
.page { padding:36rpx 36rpx calc(38rpx + env(safe-area-inset-bottom)); }.eyebrow { color:#7b8c77;font-size:18rpx;letter-spacing:4rpx; }.eyebrow.light { color:#d8d4ba; }.title {font-family:Georgia,"Songti SC",serif;font-size:60rpx;font-weight:500;letter-spacing:2rpx;margin-top:16rpx;}.subtitle {color:#8a9381;font-size:24rpx;line-height:1.8;margin-top:16rpx;}
.row { display:flex;align-items:center;justify-content:space-between;gap:20rpx; }.muted {color:#909786;font-size:23rpx;line-height:1.7;}.section-title {font-size:34rpx;font-weight:500;}.card{background:#fffef8;border:1rpx solid #e0e4d7;border-radius:20rpx;padding:26rpx;margin-top:24rpx;}.badge { font-size:20rpx;padding:8rpx 16rpx;border:1rpx solid #cbd2bc;border-radius:30rpx;color:#63785b; }.footnote {color:#9ba18f;font-size:20rpx;line-height:1.8;margin-top:24rpx;}
.error-panel {font-size:23rpx;background:#f1dfcf;color:#85593c;border-radius:12rpx;padding:20rpx;margin:20rpx 0;line-height:1.7;}
.empty { text-align:center;padding:90rpx 30rpx; }.empty-symbol {font-family:Georgia,serif;font-size:84rpx;color:#aabb9e;margin-bottom:24rpx;}.empty-title {font-size:30rpx;margin-bottom:14rpx;}
.skeleton {height:190rpx;margin-top:25rpx;border-radius:16rpx;background:linear-gradient(90deg,#e7e9df,#f7f7ef,#e7e9df);background-size:200% 100%;animation:shimmer 1.5s infinite;}@keyframes shimmer {to{background-position:-200% 0;}}
.pack { width:150rpx;height:218rpx;background:#e9e5d7;border-radius:3rpx 8rpx 6rpx 4rpx;border-top:34rpx solid #768d85;position:relative;box-shadow:8rpx 9rpx 0 #1c342219,18rpx 22rpx 24rpx #173b201a;transform:rotate(-7deg);padding:14rpx 15rpx;color:#2f453b; }
.pack::before {content:"";position:absolute;left:0;right:0;top:4rpx;height:1rpx;background:#8d9d8155;}.pack::after {content:"";position:absolute;right:4rpx;top:-33rpx;bottom:0;width:6rpx;background:#ffffff25;border-left:1rpx solid #18362015;}
.pack-brand {font-size:12rpx;letter-spacing:3rpx;}.pack-name {font-family:Georgia,"Songti SC",serif;font-size:33rpx;letter-spacing:7rpx;margin-top:29rpx;}.pack-line {width:24rpx;height:1rpx;background:#a7a480;margin:17rpx 0 13rpx;}.pack-caption {font-size:12rpx;letter-spacing:2rpx;color:#89947b;}
.modal-mask {position:fixed;inset:0;background:#10201970;display:flex;align-items:flex-end;z-index:100;}.bottom-sheet {width:100%;background:#f3f2eb;border-radius:30rpx 30rpx 0 0;padding:20rpx 36rpx calc(32rpx + env(safe-area-inset-bottom));color:#253a33;}.sheet-handle {width:66rpx;height:7rpx;border-radius:10rpx;background:#ccd2c2;margin:0 auto 26rpx;}.close {font-size:42rpx;line-height:1;padding:12rpx;color:#7d8e76;}

