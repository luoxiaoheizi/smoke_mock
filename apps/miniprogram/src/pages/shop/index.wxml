<view class="page shop-page">
  <view class="row"><view class="eyebrow">THE LITTLE CABINET</view><view class="wallet-pill" bindtap="wallet"><text class="coin-symbol">✦</text> {{coins}} <text class="wallet-arrow">↗</text></view></view>
  <view class="title">橱窗里，<view>有下一刻。</view></view><view class="subtitle">挑一种颜色，带进你的日常。</view>
  <view wx:if="{{error}}" class="error-panel" bindtap="refresh">{{error}} · 点击重试</view>
  <view wx:if="{{loading}}" class="skeleton"></view>
  <view wx:else class="cabinet">
    <view class="shelf" wx:for="{{products}}" wx:key="id" data-id="{{item.id}}" bindtap="detail">
      <view class="shelf-number">0{{index + 1}}</view>
      <view class="pack" style="border-top-color:{{item.color}}"><view class="pack-brand">MOMENT</view><view class="pack-name">{{item.name}}</view><view class="pack-line"></view><view class="pack-caption">留一点时间</view></view>
      <view class="product-info"><view class="series">{{item.unlimited ? 'THE EVERYDAY' : index === 1 ? 'AFTER THE RAIN' : 'AFTER HOURS'}}</view><view class="product-title">{{item.name}}</view><view class="muted">{{item.unlimited ? '素净原色，随时取用。' : index === 1 ? '雨洗过的青绿色。' : '把夜色收进口袋。'}}</view><view class="product-price">{{item.unlimited ? '免费取用' : item.price + ' 火花币'}}<text wx:if="{{!item.unlimited}}"> / 盒</text></view><view class="detail-link">看看这一款 ↗</view></view>
      <view class="shelf-plank"></view>
    </view>
  </view>
  <view class="supply row"><view><view class="supply-title">今天的小小补给</view><view class="muted">20 枚火花币，留着慢慢挑。</view></view><button class="small secondary" bindtap="claim" disabled="{{busy || claimed || loading || !!error}}">{{claimed ? '已收好' : '收下'}}</button></view>
  <view class="footnote">橱窗内均为原创虚拟道具。火花币仅在这里使用，不涉及真实货币交易。</view>
</view>

