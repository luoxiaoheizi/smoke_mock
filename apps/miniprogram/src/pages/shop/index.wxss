.shop-page { padding-top:24rpx; }
.shop-header { align-items:flex-start; }
.shop-header .title { margin-top:8rpx; }
button.wallet-pill { display:flex; width:auto; flex-shrink:0; align-items:center; gap:14rpx; min-width:156rpx; min-height:84rpx; background:var(--color-surface); border:1rpx solid var(--color-border); padding:14rpx 20rpx; border-radius:40rpx; font-size:28rpx; font-family:var(--font-number); }
.coin-symbol { color:var(--color-accent); font-family:var(--font-body); }
.wallet-arrow { font-size:24rpx; color:var(--color-muted); }
.supply { margin-top:30rpx; padding:24rpx; border:1rpx solid var(--color-border); border-radius:var(--radius-control); background:var(--color-soft); }
.supply-title { font-size:27rpx; font-weight:600; margin-bottom:5rpx; }
.supply .muted { font-size:23rpx; }
.supply button { min-width:144rpx; }
.cabinet { background:#dce5d9; padding:0 24rpx; border-radius:var(--radius-panel); overflow:hidden; border:1rpx solid #becbbb; box-shadow:inset 0 4rpx 18rpx #344f4110; }
button.shelf { width:100%; position:relative; display:flex; align-items:center; gap:40rpx; padding:38rpx 12rpx 42rpx; border-radius:0; text-align:left; background:transparent; min-height:296rpx; }
.shelf .pack { margin-left:20rpx; flex-shrink:0; transform:rotate(-5deg); }
.shelf-plank { position:absolute; bottom:0; left:-24rpx; right:-24rpx; height:10rpx; background:#a6b99f; border-top:3rpx solid #c8d7c1; box-shadow:0 9rpx 15rpx #344f4126; }
.shelf:last-child .shelf-plank { display:none; }
.product-info { flex:1; min-width:0; }
.series { font-size:21rpx; color:var(--color-muted); }
.product-title { font-size:37rpx; font-family:var(--font-display); font-weight:600; margin:9rpx 0; }
.product-info .muted { font-size:23rpx; }
.product-price { font-size:27rpx; font-weight:600; margin-top:22rpx; }
.product-price text { font-size:22rpx; font-weight:400; }
.detail-link { color:var(--color-primary); font-size:22rpx; margin-top:13rpx; }
@media (max-width:350px) { button.shelf { gap:26rpx; } .shelf .pack { margin-left:8rpx; } }

.shelf .product-image { width:150rpx; height:238rpx; flex-shrink:0; margin-left:20rpx; object-fit:contain; }
@media (max-width:350px) { .shelf .product-image { margin-left:8rpx; } }
