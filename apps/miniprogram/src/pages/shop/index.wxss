.shop-page{padding-top:34rpx}.wallet-pill{display:flex;align-items:center;gap:12rpx;background:#e4e8d9;padding:14rpx 20rpx;border-radius:30rpx;font-size:25rpx}.coin-symbol{color:#9f8950}.wallet-arrow{font-size:20rpx;color:#78856d}.title{font-size:64rpx;line-height:1.25;margin-top:33rpx}.cabinet{margin-top:28rpx;background:linear-gradient(90deg,#e1e5d8,#edf0e5 50%,#e1e5d8);padding:0 26rpx;border-radius:20rpx;overflow:hidden;border:1rpx solid #d9dece}.shelf{position:relative;display:flex;align-items:center;gap:42rpx;padding:49rpx 8rpx 44rpx}.shelf .pack{margin-left:26rpx;flex-shrink:0}.shelf-number{position:absolute;top:22rpx;left:0;font-size:17rpx;letter-spacing:2rpx;color:#8e9b80}.shelf-plank{position:absolute;bottom:0;left:-26rpx;right:-26rpx;height:13rpx;background:linear-gradient(#c2bfa7,#a8ae95);box-shadow:0 12rpx 20rpx #344e2820}.product-info{flex:1;min-width:0}.series{font-size:15rpx;letter-spacing:2rpx;color:#929c86}.product-title{font-size:37rpx;margin:14rpx 0}.product-info .muted{font-size:21rpx}.product-price{font-size:26rpx;margin-top:25rpx}.product-price text{font-size:18rpx;color:#8b967f}.detail-link{color:#72856a;font-size:20rpx;margin-top:16rpx}.supply{margin-top:38rpx;padding:27rpx 0;border-top:1rpx solid #d5dcca;border-bottom:1rpx solid #d5dcca}.supply-title{font-size:27rpx;margin-bottom:8rpx}

