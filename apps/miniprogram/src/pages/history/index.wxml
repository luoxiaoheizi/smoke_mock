<view class="page"><view class="eyebrow">MOMENTS THAT STAY</view><view class="title">过去的此刻。</view><view class="subtitle">时间走过了，片刻还在。</view>
<view wx:if="{{error}}" class="error-panel" bindtap="refresh">{{error}} · 重试</view><view wx:if="{{loading}}" class="skeleton"></view>
<view wx:if="{{!loading && !error && !rows.length}}" class="empty"><view class="empty-symbol">◌</view><view class="empty-title">这里还很安静。</view><view class="muted">完成一次体验，第一段片刻就会留在这里。</view><button class="primary empty-button" bindtap="goExperience">去体验一下 ↗</button></view>
<view class="moment-card" wx:for="{{rows}}" wx:key="id"><view class="row"><view class="moment-date">{{item.date}}</view><view class="badge">{{item.place}}</view></view><view class="moment-text">{{item.eventText}}</view><view class="moment-bottom"><view class="small-line"></view><text>{{item.product}} · 这一刻已结束</text></view></view>
<button wx:if="{{rows.length < total}}" class="secondary small more" bindtap="more" loading="{{loadingMore}}">再往前看看</button></view>

