<view class="page"><view class="eyebrow">此刻 · 情境手记</view><view class="title">过去的此刻。</view><view class="subtitle">地点、时间，还有当时的小小插曲。</view>
<button wx:if="{{error}}" class="error-panel" bindtap="refresh">{{error}}<text class="error-action">重新加载 →</text></button>
<view wx:elif="{{loading}}" class="loading-state"><view class="loading-dot"></view><text>正在翻阅手记…</text></view>
<view wx:else>
<view wx:if="{{!rows.length}}" class="empty"><view class="empty-symbol" aria-hidden="true">◌</view><view class="empty-title">第一段片刻，留给今天。</view><view class="muted">完成一次体验，时间、地点和故事会自动留在这里。</view><button class="primary empty-button" bindtap="goExperience">去体验 →</button></view>
<view wx:else class="row section-heading"><view class="section-title">已留下 {{total}} 段片刻</view><text class="section-meta">北京时间</text></view>
<view class="moment-card" wx:for="{{rows}}" wx:key="id"><view class="row"><view class="moment-date">{{item.date}}</view><view class="badge">{{item.place}}</view></view><view class="moment-text">{{item.eventText}}</view><view class="moment-bottom"><view class="small-line"></view><text>{{item.product}} · 已结束</text></view></view>
<button wx:if="{{rows.length < total}}" class="secondary small more" bindtap="more" disabled="{{loadingMore}}" loading="{{loadingMore}}">加载更多</button><view wx:elif="{{rows.length}}" class="footnote">已经翻到最初的那一刻。</view>
</view></view>
