.experience { height:100vh; min-height:900rpx; overflow:hidden; position:relative; background:#334743; }
.scene-canvas { position:absolute; width:100%; height:100%; inset:0; }
.scene-shade { pointer-events:none; position:absolute; inset:0; background:linear-gradient(180deg,#0c191bcc,transparent 40%,transparent 55%,#0c191bf2); }
.top-panel { position:absolute; top:0; left:0; right:0; padding:20rpx 36rpx; color:#f1f4e9; }
.clock-caption { font-size:22rpx; letter-spacing:2rpx; color:#d1ddce; margin-top:20rpx; }
.clock { font-size:94rpx; font-weight:400; letter-spacing:-5rpx; line-height:1.2; font-family:var(--font-number); }
button.round-action { font-size:24rpx; width:auto; min-width:96rpx; min-height:80rpx; padding:15rpx; background:#18352b70; color:#f1f4e9; border:1rpx solid #e1ead940; border-radius:40rpx; }
button.location { margin-top:14rpx; display:inline-flex; width:auto; align-items:center; gap:12rpx; min-height:72rpx; padding:12rpx 20rpx; font-size:26rpx; color:#f1f4e9; background:#1a352bd9; border:1rpx solid #e1ead940; border-radius:40rpx; }
.live-dot { width:10rpx; height:10rpx; border-radius:50%; background:#dcc191; }
.location-chevron { margin-left:8rpx; color:#e1cda9; font-size:23rpx; }
.story { position:absolute; top:31%; left:11%; width:78%; text-align:center; line-height:1.85; font-size:30rpx; color:#fff9e8; opacity:0; transition:opacity .6s; pointer-events:none; text-shadow:0 2rpx 12rpx #172823; }
.story.visible { opacity:1; }.story-line { height:2rpx; width:36rpx; background:#d3c39f; margin:0 auto 22rpx; }
.bottom-panel { position:absolute; bottom:0; width:100%; padding:22rpx 36rpx calc(24rpx + env(safe-area-inset-bottom)); color:#f1f4e9; }
.current-item { margin-bottom:10rpx; border-top:1rpx solid #d4dfcc40; padding-top:12rpx; }
button.current-product { text-align:left; display:block; min-height:80rpx; padding:6rpx 0; }
.tiny-label { display:block; font-size:21rpx; letter-spacing:1rpx; color:#c9d6c4; }
.item-name { display:block; margin-top:5rpx; font-size:28rpx; }
.moment-label { font-size:23rpx; color:#c9d6c4; }
.hint { font-size:23rpx; color:#d1ddce; text-align:center; min-height:48rpx; line-height:1.6; padding-bottom:12rpx; }
.enter-button { width:100%; text-align:left; }
.experience button.primary { background:#d8e7cf; color:#203b30; }
.button-arrow { float:right; font-size:32rpx; }
.controls { display:flex; gap:12rpx; }.controls button { flex:1; padding:23rpx 8rpx; min-width:0; }.controls .hold { flex:1.65; }.controls .holding { background:#b4cda7; }
button.glass { background:#244239; border:1rpx solid #c5d8bf50; color:#f1f4e9; }
.experience button[disabled] { background:#2f4439; color:#b1c2a8; opacity:.65; }
button.finish-action { width:100%; text-align:center; color:#d1ddce; font-size:24rpx; min-height:68rpx; padding:16rpx 0 0; background:transparent; }
.burn-track { height:4rpx; background:#d4dfcc40; margin-bottom:20rpx; }.burn-track view { background:#dcc191; height:100%; transition:width .5s linear; }
.lighter-hotspot { position:absolute; left:14%; top:54%; width:28%; height:15%; z-index:1; }.hotspot-dot { position:absolute; left:24%; top:20%; height:16rpx; width:16rpx; border:2rpx solid #e1c692; border-radius:50%; box-shadow:0 0 0 12rpx #d9c39118; }
.hand-hotspot { position:absolute; right:1%; top:46%; width:39%; height:24%; z-index:1; }
.canvas-fallback { position:absolute; top:38%; left:10%; width:80%; text-align:center; color:#f1f4e9; z-index:2; background:#18352bdd; padding:24rpx; border-radius:16rpx; }
button.sync-note { width:100%; color:#f4dda9; background:#393d29; font-size:23rpx; text-align:left; padding:18rpx; margin-bottom:12rpx; min-height:72rpx; }
.bottom-panel .error-panel { padding:16rpx 20rpx; margin:0 0 12rpx; font-size:23rpx; }
button.scene-choice { display:flex; align-items:center; gap:22rpx; padding:20rpx; margin-top:20rpx; width:100%; text-align:left; border:1rpx solid var(--color-border); background:var(--color-surface); }
button.scene-choice.selected { background:var(--color-soft); border-color:#9aaf8f; }
.scene-info { flex:1; font-size:29rpx; }.scene-info .muted { font-size:23rpx; margin-top:8rpx; }.check-mark { color:var(--color-primary); font-size:25rpx; }
.scene-thumb { width:100rpx; height:114rpx; border-radius:10rpx; position:relative; overflow:hidden; flex-shrink:0; }.scene-thumb.toilet { background:#5d7868; }.scene-thumb.toilet view { position:absolute; inset:16rpx; border:2rpx solid #293f32; border-bottom:5rpx solid #c6b892; }.scene-thumb.balcony { background:#829b9b; }.scene-thumb.balcony view { position:absolute; bottom:20rpx; width:100%; height:36rpx; border-top:6rpx solid #293e43; background:repeating-linear-gradient(90deg,transparent,transparent 22rpx,#293e43 24rpx,#293e43 27rpx); }
@media (max-height:620px) { .clock-caption { margin-top:0; }.clock { font-size:70rpx; }.story { top:32%; font-size:26rpx; }.current-item { padding-top:4rpx; }.hint { padding-bottom:6rpx; } }
