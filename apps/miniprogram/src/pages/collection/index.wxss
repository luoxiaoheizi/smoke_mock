.collection-item { display:flex; align-items:center; gap:22rpx; padding:28rpx 24rpx; margin-top:18rpx; border:1rpx solid var(--color-border); border-radius:var(--radius-control); background:var(--color-surface); }
.collection-item.chosen { background:var(--color-soft); border-color:#9aaf8f; }
.mini-pack { width:82rpx; height:114rpx; border-top:20rpx solid; background:#eeeade; box-shadow:5rpx 6rpx 0 #152b1613; display:flex; align-items:center; justify-content:center; font-family:var(--font-display); letter-spacing:4rpx; font-size:24rpx; flex-shrink:0; }
.collection-info { flex:1; min-width:0; }
.collection-name { font-size:30rpx; font-weight:600; margin-bottom:8rpx; }
.selected-label { display:block; font-size:22rpx; font-weight:400; color:var(--color-primary); margin-top:5rpx; }
.collection-info .muted { font-size:23rpx; }
.collection-item button { min-width:118rpx; }
.menu { margin-top:32rpx; border:1rpx solid var(--color-border); border-radius:var(--radius-panel); padding:0 24rpx; background:var(--color-surface); }
button.menu-row { width:100%; padding:28rpx 0; border-radius:0; border-bottom:1rpx solid var(--color-border); background:transparent; text-align:left; }
button.menu-row:last-child { border-bottom:0; }
.menu-row .muted { margin-top:8rpx; font-size:23rpx; }
.menu-row>text { font-size:25rpx; color:var(--color-primary); flex-shrink:0; }
.back-button { margin-top:32rpx; width:100%; }

.collection-image { width:82rpx; height:132rpx; flex-shrink:0; object-fit:contain; }
.mini-pack { letter-spacing:0; padding:4rpx; text-align:center; overflow-wrap:anywhere; }
