<view class="page"><view class="eyebrow">LITTLE SPARKS</view><view class="balance-card"><view class="balance-label">我的火花币</view><view class="balance">{{coins}}<text> 枚</text></view><view class="balance-note">攒一点，换一个喜欢的外观。</view></view>
<view wx:if="{{error}}" class="error-panel" bindtap="refresh">{{error}} · 重试</view>
<view class="daily row"><view><view>今天的补给</view><view class="muted">每天 20 枚，自在收下。</view></view><button class="small primary" bindtap="claim" disabled="{{claimed || busy || loading || !!error}}">{{claimed?'已领取':'+20 · 领取'}}</button></view>
<view class="section-title ledger-title">来去有记录</view><view wx:if="{{loading}}" class="skeleton"></view>
<view class="ledger-row row" wx:for="{{rows}}" wx:key="id"><view><view>{{item.title}}</view><view class="muted">{{item.date}} · 余额 {{item.balance}}</view></view><text class="{{item.amount > 0 ? 'income' : 'expense'}}">{{item.amountLabel}}</text></view>
<view wx:if="{{!loading && !error && !rows.length}}" class="empty"><view class="muted">还没有记录，先收下今天的补给吧。</view></view>
<button wx:if="{{rows.length < total}}" class="small secondary more" bindtap="more" loading="{{loadingMore}}">查看更多</button><view class="footnote">火花币只用于兑换虚拟道具，不支持充值、转让或提现。</view></view>

