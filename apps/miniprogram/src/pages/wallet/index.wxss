.balance-card{background:#344f41;color:#eff0de;border-radius:22rpx;padding:35rpx;margin-top:26rpx;position:relative;overflow:hidden}.balance-card::after{content:"✦";position:absolute;right:25rpx;top:35rpx;font-size:145rpx;color:#a9bd8c24}.balance-label{font-size:23rpx;letter-spacing:2rpx;color:#c3d0b5}.balance{font-family:Georgia,serif;font-size:100rpx;margin:16rpx 0}.balance text{font-size:22rpx}.balance-note{color:#b8c9aa;font-size:23rpx}.daily{padding:35rpx 0;border-bottom:1rpx solid #d6decb}.daily .muted{margin-top:10rpx}.ledger-title{margin-top:38rpx}.ledger-row{padding:30rpx 0;border-bottom:1rpx solid #dce2d3;font-size:26rpx}.ledger-row .muted{font-size:20rpx;margin-top:9rpx}.income{color:#638454;font-size:32rpx}.expense{color:#8d8069;font-size:32rpx}.more{margin:26rpx auto 0}

