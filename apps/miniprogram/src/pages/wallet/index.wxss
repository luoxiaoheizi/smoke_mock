.balance-card { background:var(--color-primary); color:var(--color-on-primary); border-radius:var(--radius-panel); padding:34rpx; margin-top:26rpx; position:relative; overflow:hidden; }
.balance-label { font-size:25rpx; color:#d3dfc9; }
.balance { font-family:var(--font-number); font-size:90rpx; letter-spacing:-4rpx; line-height:1.3; margin:20rpx 0; }
.balance text { font-family:var(--font-body); font-size:25rpx; letter-spacing:0; }
.balance-note { color:#d3dfc9; font-size:24rpx; border-top:1rpx solid #ffffff30; padding-top:22rpx; }
.daily { padding:30rpx 0; border-bottom:1rpx solid var(--color-border); }
.daily .muted { margin-top:8rpx; }
.ledger-title { margin-top:36rpx; }
.ledger-row { padding:28rpx 0; border-bottom:1rpx solid var(--color-border); font-size:27rpx; }
.ledger-row .muted { font-size:23rpx; margin-top:8rpx; }
.ledger-row>text { font-family:var(--font-number); font-size:32rpx; flex-shrink:0; }
.income { color:var(--color-primary); }.expense { color:var(--color-accent); }
.more { margin:26rpx auto 0; }
.ad-rewards { padding:30rpx 0; border-bottom:1rpx solid var(--color-border); }
.reward-steps { display:flex; gap:12rpx; margin:24rpx 0; }
.reward-step { flex:1; min-width:0; text-align:center; padding:22rpx 8rpx; border:1rpx solid var(--color-border); border-radius:var(--radius-control); background:var(--color-surface); }
.reward-done { background:var(--color-soft); }
.reward-step .muted { font-size:23rpx; }
.reward-amount { font-family:var(--font-number); font-size:35rpx; font-weight:600; margin:12rpx 0; }
.reward-status { color:var(--color-muted); font-size:22rpx; }
.ad-button { width:100%; margin-top:24rpx; }
.demo-note { font-size:24rpx; color:var(--color-accent); }
.reward-error { padding:18rpx; margin-top:18rpx; border-radius:var(--radius-control); color:var(--color-danger); background:var(--color-error-bg); font-size:24rpx; }
