.product-page{padding-bottom:170rpx}.product-hero{height:620rpx;background:linear-gradient(140deg,#d9e0ce,#eef0e6);position:relative;display:flex;align-items:center;justify-content:center;overflow:hidden}.hero-label{position:absolute;top:35rpx;left:36rpx;color:#82947a;letter-spacing:3rpx;font-size:17rpx}.hero-circle{position:absolute;width:470rpx;height:470rpx;border:1rpx solid #a6b49a55;border-radius:50%;left:50%;top:50%;transform:translate(-50%,-50%)}.hero-circle::after{content:"";position:absolute;inset:35rpx;border:1rpx solid #a6b49a33;border-radius:50%}.product-hero .pack{transform:scale(1.75) rotate(-10deg);margin-top:5rpx}.hero-caption{position:absolute;bottom:32rpx;font-size:20rpx;color:#93a084;letter-spacing:3rpx}.product-copy .title{margin:0}.description{font-size:27rpx;color:#77876e;line-height:2;margin-top:24rpx}.specs{border-top:1rpx solid #d7decd;margin-top:32rpx;padding-top:16rpx}.specs .row{font-size:24rpx;padding:18rpx 0}.specs .row text:first-child{color:#8e9a84}.purchase-bar{position:fixed;bottom:0;left:0;right:0;background:#fafaf1;border-top:1rpx solid #dde3d2;padding:25rpx 36rpx calc(25rpx + env(safe-area-inset-bottom));display:flex;justify-content:space-between;align-items:center;gap:20rpx}.purchase-bar button{min-width:290rpx}.price{font-size:31rpx}.success-note{background:#e2ecd9;border-radius:12rpx;padding:20rpx;font-size:23rpx;color:#58724c;margin-top:24rpx}

