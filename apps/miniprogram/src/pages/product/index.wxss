.product-page { padding-bottom:calc(200rpx + env(safe-area-inset-bottom)); }
.product-hero { height:470rpx; background:#dce5d9; position:relative; display:flex; align-items:center; justify-content:center; overflow:hidden; }
.hero-label { position:absolute; top:28rpx; left:36rpx; color:var(--color-muted); letter-spacing:2rpx; font-size:22rpx; }
.hero-circle { position:absolute; width:360rpx; height:280rpx; border:1rpx solid #b5c7ad; border-radius:50% 50% 12rpx 12rpx; left:50%; top:51%; transform:translate(-50%,-50%); background:#e7eddf; }
.product-hero .pack { transform:scale(1.3) rotate(-9deg); margin-top:20rpx; }
.hero-caption { position:absolute; bottom:24rpx; font-size:22rpx; color:var(--color-muted); letter-spacing:2rpx; }
.product-copy .title { margin:0; }
.description { font-size:27rpx; color:var(--color-muted); line-height:1.9; margin-top:24rpx; }
.specs { border-top:1rpx solid var(--color-border); margin-top:28rpx; padding-top:12rpx; }
.specs .row { font-size:25rpx; min-height:66rpx; padding:10rpx 0; }
.specs .row text:first-child { color:var(--color-muted); }
.specs .link-button { min-height:60rpx; padding:0; }
.purchase-bar { position:fixed; z-index:10; bottom:0; left:0; right:0; background:var(--color-surface); border-top:1rpx solid var(--color-border); padding:24rpx var(--page-gutter) calc(24rpx + env(safe-area-inset-bottom)); display:flex; justify-content:space-between; align-items:center; gap:22rpx; }
.purchase-bar button { width:320rpx; max-width:55%; flex-shrink:0; }
.price { font-size:30rpx; font-weight:600; white-space:nowrap; }
.success-note { background:var(--color-soft); border-radius:var(--radius-control); padding:22rpx; font-size:25rpx; color:var(--color-primary); margin-top:24rpx; }
.insufficient { margin-top:24rpx; }

.hero-image { position:relative; width:196rpx; height:310rpx; margin-top:12rpx; object-fit:contain; }
.product-copy > .row { flex-wrap:wrap; gap:14rpx; }
.specs .row { align-items:flex-start; gap:24rpx; }
.specs .row text:first-child { flex-shrink:0; }
.specs .row text:last-child { text-align:right; overflow-wrap:anywhere; }
