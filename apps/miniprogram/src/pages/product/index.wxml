<view class="product-page">
  <view wx:if="{{error}}" class="page"><button class="error-panel" bindtap="refresh">{{error}}<text class="error-action">重新加载 →</text></button></view>
  <view wx:elif="{{loading}}" class="loading-state"><view class="loading-dot"></view><text>正在读取这一款…</text></view>
  <view wx:else>
    <view class="product-hero"><view class="hero-label">此刻 · {{product.series}}</view><view class="hero-circle"></view><image wx:if="{{product.image && !imageFailed}}" class="hero-image" src="{{product.image}}" mode="aspectFit" binderror="imageError" aria-label="{{product.name}}包装参考图" /><view wx:else class="pack" style="border-top-color:{{product.color}}"><view class="pack-brand">{{product.brand || "MOMENT"}}</view><view class="pack-name">{{product.name}}</view><view class="pack-line"></view><view class="pack-caption">留一点时间</view></view><view class="hero-caption">{{product.brand ? '包装参考 · 虚拟道具' : '一种外观，一点心情。'}}</view></view>
    <view class="page product-copy"><view class="row"><view class="title">{{product.name}}</view><view class="badge">{{product.series}}</view></view>
      <view class="description">{{product.description}}</view>
      <view class="specs"><view wx:if="{{product.brand}}" class="row"><text>品牌 / 包装</text><text>{{product.brand}} / {{product.packaging}}</text></view><view wx:if="{{product.lengthMm}}" class="row"><text>烟支长度</text><text>{{product.lengthMm}} mm</text></view><view wx:if="{{product.manufacturer}}" class="row"><text>生产企业</text><text>{{product.manufacturer}}</text></view><view class="row"><text>购买规格</text><text>{{product.unlimited ? '不限次数，随时可用' : product.packSize + ' 支 / 包'}}</text></view><view class="row"><text>已经拥有</text><text>{{product.unlimited ? '始终在你的收藏里' : owned + ' 支'}}</text></view><view class="row"><text>虚拟余额</text><button class="link-button" bindtap="wallet">￥{{coins}} →</button></view></view>
      <view wx:if="{{bought}}" class="success-note">已经收好了。可以马上选用，也可以留待下次。</view>
      <button wx:if="{{!product.unlimited && !bought && coins < product.price}}" class="secondary insufficient" bindtap="wallet">余额不足，去钱包获取余额 →</button>
      <view class="footnote">{{product.brand ? '包装与规格参考公开图鉴，批次可能不同。仅供模拟展示，与品牌方无合作或背书关系。' : '这是原创虚拟外观。'}}品牌款按公开零售参考价配置，各地实际售价可能不同。￥ / 元表示虚拟余额，不可充值或提现。</view>
    </view>
    <view class="purchase-bar"><view><view class="price">{{product.unlimited ? '免费' : '￥' + product.price}}</view><view class="muted">{{product.unlimited ? '随时取用' : '每包 ' + product.packSize + ' 支'}}</view></view>
      <button wx:if="{{bought || product.unlimited}}" class="primary" bindtap="use" disabled="{{busy || loading}}" loading="{{busy}}">选用这一款</button>
      <button wx:else class="primary" bindtap="buy" disabled="{{busy || loading || coins < product.price}}" loading="{{busy}}">{{coins < product.price ? '余额不足' : '购买一包'}}</button>
    </view>
  </view>
</view>

