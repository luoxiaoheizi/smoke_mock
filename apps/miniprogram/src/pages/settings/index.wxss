.settings-card { margin-top:32rpx; background:var(--color-surface); border:1rpx solid var(--color-border); border-radius:var(--radius-panel); padding:0 24rpx; }
.setting-row { min-height:150rpx; padding:28rpx 0; border-bottom:1rpx solid var(--color-border); font-size:29rpx; }
.setting-row .setting-copy { flex:1; }
.setting-row .muted { font-size:23rpx; margin-top:8rpx; }
.setting-row switch { flex-shrink:0; }
.quality-row { border-bottom:0; flex-wrap:wrap; }
.quality { font-size:25rpx; color:var(--color-primary); }
.about { margin-top:72rpx; padding-top:32rpx; border-top:1rpx solid var(--color-border); }
.about .muted { margin-top:16rpx; }
